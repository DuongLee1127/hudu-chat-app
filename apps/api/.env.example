PORT=5000
MONGODB_CONNECT_URL=mongodb://127.0.0.1:27017/hudu-chat

JWT_ACCESS_TOKEN=...
JWT_REFRESH_TOKEN=...

CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
CLOUDINARY_FOLDER=hudu-chat/attachments

# Web Push (optional) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hudu.local

# AI bot / summarize (optional OpenAI-compatible)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
